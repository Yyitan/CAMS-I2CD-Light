+    def compute_i2cd_loss(self, com_feature, attr_anchor, obj_anchor,
+                          attr_prompt, obj_prompt, com_prompt,
+                          att_id, obj_id, pair_id):
+        attr_feature, obj_feature, recomposed_feature, attr_cycle, obj_cycle = self.i2cd_light(com_feature)
+
+        attr_logits = self.temp_logit * attr_feature @ attr_prompt.T
+        obj_logits = self.temp_logit * obj_feature @ obj_prompt.T
+        comp_logits = self.temp_logit * recomposed_feature @ com_prompt.T
+        attr_cycle_logits = self.temp_logit * attr_cycle @ attr_prompt.T
+        obj_cycle_logits = self.temp_logit * obj_cycle @ obj_prompt.T
+
+        dis_loss = 0.5 * (
+            F.cross_entropy(attr_logits, att_id) +
+            F.cross_entropy(obj_logits, obj_id)
+        )
+        comp_loss = F.cross_entropy(comp_logits, pair_id)
+        re_loss = 0.5 * (
+            F.cross_entropy(attr_cycle_logits, att_id) +
+            F.cross_entropy(obj_cycle_logits, obj_id)
+        )
+        cycle_loss = 0.5 * (
+            1 - F.cosine_similarity(attr_cycle, attr_feature.detach(), dim=-1).mean() +
+            1 - F.cosine_similarity(obj_cycle, obj_feature.detach(), dim=-1).mean()
+        )
+        anchor_loss = 0.5 * (
+            1 - F.cosine_similarity(attr_feature, attr_anchor.detach(), dim=-1).mean() +
+            1 - F.cosine_similarity(obj_feature, obj_anchor.detach(), dim=-1).mean()
+        )
+
+        i2cd_loss = (
+            getattr(self.args, "lambda_i2cd_dis", 0.1) * dis_loss +
+            getattr(self.args, "lambda_i2cd_comp", 0.1) * comp_loss +
+            getattr(self.args, "lambda_i2cd_re", 0.05) * re_loss +
+            getattr(self.args, "lambda_i2cd_cycle", 0.05) * cycle_loss +
+            getattr(self.args, "lambda_i2cd_anchor", 0.05) * anchor_loss
+        )
+        self.last_i2cd_stats = {
+            "i2cd": float(i2cd_loss.detach().cpu()),
+            "dis": float(dis_loss.detach().cpu()),
+            "comp": float(comp_loss.detach().cpu()),
+            "re": float(re_loss.detach().cpu()),
+            "cycle": float(cycle_loss.detach().cpu()),
+            "anchor": float(anchor_loss.detach().cpu()),
+        }
+        return i2cd_loss
+
+    def refine_composition_prompts(self, com_prompt, attr_prompt, obj_prompt, pair_idx, return_loss=False):
+        if not self.use_prompt_i2cd:
+            if return_loss:
+                return com_prompt, None
+            return com_prompt
+
+        outputs = self.prompt_i2cd(com_prompt, attr_prompt, obj_prompt, pair_idx)
+        refined_prompt = outputs["refined_prompt"]
+
+        if not return_loss:
+            return refined_prompt
+
+        compose_loss = 1 - F.cosine_similarity(
+            outputs["composed_prompt"],
+            com_prompt.detach(),
+            dim=-1,
+        ).mean()
+        dis_loss = 0.5 * (
+            1 - F.cosine_similarity(
+                outputs["disentangled_attr"],
+                outputs["pair_attr_prompt"].detach(),
+                dim=-1,
+            ).mean() +
+            1 - F.cosine_similarity(
+                outputs["disentangled_obj"],
+                outputs["pair_obj_prompt"].detach(),
+                dim=-1,
+            ).mean()
+        )
+        re_loss = 0.5 * (
+            1 - F.cosine_similarity(
+                outputs["redist_attr"],
+                outputs["pair_attr_prompt"].detach(),
+                dim=-1,
+            ).mean() +
+            1 - F.cosine_similarity(
+                outputs["redist_obj"],
+                outputs["pair_obj_prompt"].detach(),
+                dim=-1,
+            ).mean()
+        )
+        cycle_loss = 0.5 * (
+            1 - F.cosine_similarity(
+                outputs["redist_attr"],
+                outputs["disentangled_attr"].detach(),
+                dim=-1,
+            ).mean() +
+            1 - F.cosine_similarity(
+                outputs["redist_obj"],
+                outputs["disentangled_obj"].detach(),
+                dim=-1,
+            ).mean()
+        )
+
+        prompt_i2cd_loss = (
+            getattr(self.args, "lambda_prompt_i2cd_compose", 0.05) * compose_loss +
+            getattr(self.args, "lambda_prompt_i2cd_dis", 0.05) * dis_loss +
+            getattr(self.args, "lambda_prompt_i2cd_re", 0.025) * re_loss +
+            getattr(self.args, "lambda_prompt_i2cd_cycle", 0.025) * cycle_loss
+        )
+        self.last_prompt_i2cd_stats = {
+            "prompt_i2cd": float(prompt_i2cd_loss.detach().cpu()),
+            "p_comp": float(compose_loss.detach().cpu()),
+            "p_dis": float(dis_loss.detach().cpu()),
+            "p_re": float(re_loss.detach().cpu()),
+            "p_cycle": float(cycle_loss.detach().cpu()),
+            "p_mix": float(outputs["mix"].detach().cpu()),
+        }
+        return refined_prompt, prompt_i2cd_loss
     
